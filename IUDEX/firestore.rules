rules_version = '2';

// ==========================================================================
// e-CON - Firestore Security Rules
//
// e-CON is a public, username-based messenger: anyone may create an account,
// so there is no email whitelist here any more. Access is scoped by uid.
//
// The model in one line: profiles and usernames are publicly readable to
// signed-in users (that is what makes search work), everything else is
// readable only by the two people in the conversation.
// ==========================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // ---- Profiles -------------------------------------------------------
    // Readable by any signed-in user (Discover and @username search need
    // this), writable only by their owner.
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if isSelf(uid);

      // `username` is claimed through the /usernames transaction and must
      // never be reassigned by a direct profile write - otherwise a user
      // could take a handle without ever touching the reservation doc.
      allow update: if isSelf(uid)
                    && (!("username" in request.resource.data)
                        || !("username" in resource.data)
                        || request.resource.data.username == resource.data.username);

      allow delete: if false;
    }

    // Minimal profile projection for username discovery. Keeping this
    // separate means Discover can never read email or account-only fields.
    match /publicProfiles/{uid} {
      allow read: if signedIn();
      allow create, update: if isSelf(uid)
                            && request.resource.data.keys().hasOnly(
                                 ['username', 'name', 'photoURL']);
      allow delete: if false;
    }

    // ---- Username reservations -----------------------------------------
    // Document id IS the username, so Firestore itself enforces uniqueness.
    // Create only, pointing at yourself: no updates, no deletes, no
    // squatting on someone else's handle.
    match /usernames/{username} {
      allow read: if signedIn();
      allow create: if signedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.username == username
                    && username.size() >= 3
                    && username.size() <= 20;
      allow update, delete: if false;
    }

    // ---- Conversations --------------------------------------------------
    function isParticipant() {
      return signedIn() && request.auth.uid in resource.data.participants;
    }

    match /conversations/{convId} {
      // A `get` on a conversation that doesn't exist yet has no
      // `resource` to inspect, so the participants check would error out
      // and deny - which is exactly the read that "open a chat with this
      // person" performs first. Conversation ids are the two uids sorted
      // and joined, so for that case the id itself is the proof.
      allow get: if signedIn()
                 && (resource == null
                     ? request.auth.uid in convId.split('_')
                     : request.auth.uid in resource.data.participants);

      allow list: if isParticipant();

      // The other person in a brand-new conversation, computed from the
      // create payload rather than from an existing document (there isn't
      // one yet).
      function otherOf(participants) {
        return participants[0] == request.auth.uid ? participants[1] : participants[0];
      }

      // Re-derives the same "is the recipient private" answer the client
      // used to decide pending-vs-active, straight from their stored
      // profile. This is what actually enforces private accounts: without
      // it, any client could write status:"active" directly and the
      // approval step would be UI theater rather than a real gate.
      function targetIsPrivate() {
        let other = otherOf(request.resource.data.participants);
        // exists() first, same reasoning as inParentConversation() below:
        // get() on a missing document throws rather than denying cleanly.
        return exists(/databases/$(database)/documents/users/$(other))
               && get(/databases/$(database)/documents/users/$(other)).data.get('private', false) == true;
      }

      // A new conversation must include its creator, have exactly two
      // participants, carry no messages in its initial payload, and open
      // in the correct state for the recipient's privacy setting: pending
      // (attributed to its actual creator) against a private account,
      // active against a public one.
      allow create: if signedIn()
                    && request.auth.uid in request.resource.data.participants
                    && request.resource.data.participants.size() == 2
                    && (
                         targetIsPrivate()
                           ? (request.resource.data.status == 'pending'
                              && request.resource.data.requestedBy == request.auth.uid)
                           : request.resource.data.status == 'active'
                       );

      // Status only ever moves pending -> active or pending -> declined,
      // and only the *other* participant may do it - the requester can't
      // approve their own request. Every other field (typing, readAt,
      // lastMessage, participantInfo, ...) is an "ordinary" update and
      // passes through unconditionally, same as before this feature
      // existed.
      function isOrdinaryUpdate() {
        return request.resource.data.status == resource.data.status;
      }
      function isRequestDecision() {
        return resource.data.status == 'pending'
               && resource.data.requestedBy != request.auth.uid
               && (request.resource.data.status == 'active'
                   || request.resource.data.status == 'declined');
      }

      // The participant list is fixed for the life of the thread - letting
      // it change would silently add a third reader to an existing chat.
      allow update: if isParticipant()
                    && request.resource.data.participants == resource.data.participants
                    && (isOrdinaryUpdate() || isRequestDecision());

      allow delete: if false;

      match /messages/{messageId} {
        // exists() first: get() on a missing document returns null, and
        // reading .data off it throws rather than simply denying.
        function inParentConversation() {
          return signedIn()
            && exists(/databases/$(database)/documents/conversations/$(convId))
            && request.auth.uid in
               get(/databases/$(database)/documents/conversations/$(convId)).data.participants;
        }

        allow read: if inParentConversation();

        allow create: if inParentConversation()
                      && request.resource.data.senderId == request.auth.uid;

        // Anyone in the thread may update (that is how reactions and read
        // state work), but the author and body are immutable - you cannot
        // rewrite what the other person said.
        allow update: if inParentConversation()
                      && request.resource.data.senderId == resource.data.senderId
                      && request.resource.data.text == resource.data.text;

        // Only the author can delete their own message.
        allow delete: if inParentConversation()
                      && resource.data.senderId == request.auth.uid;
      }
    }

    // ---- Default deny ----------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
